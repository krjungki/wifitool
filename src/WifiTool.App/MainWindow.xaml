<!-- 현장 엔지니어가 타임라인·프로필·수집 상태를 확인하는 주 화면이다. -->
<Window x:Class="WifiTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="760" MinHeight="540" Width="900" Height="580"
        WindowStartupLocation="CenterScreen" Background="#F3F5F7"
        FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#006F5F" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FA" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17242A" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Wi-Fi 접속 이슈 분석" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AnalysisSummary}" Foreground="#B9C8CD" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#557078" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CoverageSummary}" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8DEE2" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="로컬 로그 읽기" Command="{Binding LoadLocalCommand}" />
                <Button Grid.Column="1" Content="EVTX 열기" Command="{Binding OpenEvtxCommand}" />
                <Button Grid.Column="2" Content="수집 ZIP 열기" Command="{Binding OpenPackageCommand}" />
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
                <Button Grid.Column="4" Content="취소" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Margin="8,0,0,0" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="SSID" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="190" Text="{Binding SsidFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="SSID 필터" Margin="0,0,16,0" />
                    <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="계정·사건 검색" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="14">
            <TabItem Header="진단 요약">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="관측 범위와 제한" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,14" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Findings}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D8DEE2" BorderThickness="0,0,0,1" Padding="4,12">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="22" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="원인 판정은 타임라인의 Observed/Inferred 구분과 원본 이벤트를 함께 확인하십시오." Foreground="#58666C" Margin="4,14,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="시스템 상태">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                    <TextBlock Text="부팅·종료·절전 상태" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="8,0,0,12" />
                    <DataGrid x:Name="SystemDataGrid" Grid.Row="1" ItemsSource="{Binding SystemTimeline}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170" />
                            <DataGridTextColumn Header="시스템 상태" Binding="{Binding Stage}" Width="190" />
                            <DataGridTextColumn Header="결과" Binding="{Binding Outcome}" Width="100" />
                            <DataGridTextColumn Header="근거" Binding="{Binding Evidence}" Width="100" />
                            <DataGridTextColumn Header="설명" Binding="{Binding Details}" Width="520" />
                            <DataGridTextColumn Header="원본 사건" Binding="{Binding Summary}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollBar x:Name="SystemHorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" Height="18" />
                </Grid>
            </TabItem>
            <TabItem Header="타임라인">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="TimelineDataGrid" ItemsSource="{Binding FilteredTimeline}" SelectedItem="{Binding SelectedTimeline}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155" />
                            <DataGridTextColumn Header="단계" Binding="{Binding Stage}" Width="145" />
                            <DataGridTextColumn Header="계정" Binding="{Binding Account}" Width="180" />
                            <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="140" />
                            <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="145" />
                            <DataGridTextColumn Header="결과" Binding="{Binding Outcome}" Width="90" />
                            <DataGridTextColumn Header="근거" Binding="{Binding Evidence}" Width="85" />
                            <DataGridTextColumn Header="로그온 후" Binding="{Binding SinceLogon}" Width="100" />
                            <DataGridTextColumn Header="사건" Binding="{Binding Summary}" Width="420" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollBar x:Name="TimelineHorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Height="18" />
                    <Border Grid.Column="2" Grid.RowSpan="2" Background="White" BorderBrush="#D8DEE2" BorderThickness="1" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="선택 사건" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="{Binding SelectedTimeline.Stage}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,4" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedTimeline.Details}" TextWrapping="Wrap" LineHeight="21" />
                                <Separator Margin="0,16" />
                                <TextBlock Text="계정" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedTimeline.Account, TargetNullValue=미확인}" TextWrapping="Wrap" />
                                <TextBlock Text="SSID" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding SelectedTimeline.Ssid, TargetNullValue=미확인}" TextWrapping="Wrap" />
                                <TextBlock Text="BSSID" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding SelectedTimeline.Bssid, TargetNullValue=미확인}" TextWrapping="Wrap" />
                                <TextBlock Text="이전 BSSID" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding SelectedTimeline.PreviousBssid, TargetNullValue=미확인}" TextWrapping="Wrap" />
                                <TextBlock Text="근거 ID" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <ItemsControl ItemsSource="{Binding SelectedTimeline.SourceIds}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Wi-Fi 프로필">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="SSID" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="240" Text="{Binding ProfileSsid}" Margin="0,0,8,0" />
                        <Button Content="프로필 조회" Command="{Binding LoadProfilesCommand}" />
                        <TextBlock Text="조회 버튼을 눌렀을 때만 현재 PC 프로필을 읽습니다." VerticalAlignment="Center" Foreground="#58666C" />
                    </StackPanel>
                    <DataGrid x:Name="ProfilesDataGrid" Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="180" />
                            <DataGridTextColumn Header="프로필" Binding="{Binding ProfileName}" Width="200" />
                            <DataGridTextColumn Header="인터페이스" Binding="{Binding InterfaceDescription}" Width="240" />
                            <DataGridTextColumn Header="범위" Binding="{Binding Scope}" Width="110" />
                            <DataGridTextColumn Header="수집 시각(UTC)" Binding="{Binding CapturedAt, StringFormat={}{0:u}}" Width="155" />
                            <DataGridTextColumn Header="내보내기 상태" Binding="{Binding ExportBlockedReason}" Width="420" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollBar x:Name="ProfilesHorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" Height="18" />
                </Grid>
            </TabItem>

            <TabItem Header="수집 및 범위">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="최근 24시간 ZIP 저장" Command="{Binding SavePackageCommand}" />
                        <TextBlock Text="System과 WLAN Operational을 수집합니다. Security 로그는 기본 제외됩니다." VerticalAlignment="Center" Foreground="#58666C" />
                    </StackPanel>
                    <DataGrid x:Name="CollectionDataGrid" Grid.Row="1" ItemsSource="{Binding ChannelStatuses}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="채널/입력" Binding="{Binding Channel}" Width="360" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="레코드" Binding="{Binding RecordCount}" Width="90" />
                            <DataGridTextColumn Header="상세" Binding="{Binding Details}" Width="520" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollBar x:Name="CollectionHorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" Height="18" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
